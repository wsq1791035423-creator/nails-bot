{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{web/**,knowledge/**,data/styles/web/**,data/reference/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js?__path=$1" }
  ]
}